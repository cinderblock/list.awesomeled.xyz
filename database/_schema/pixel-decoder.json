{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/pixel-decoder.json",
  "title": "Pixel Decoder",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ]
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "oneOf": [{ "$ref": "common.json#/definitions/price" }, { "type": "null" }]
    },
    "diy_or_ots": { "$ref": "common.json#/definitions/diy_or_ots" },
    "inputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocols": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "Pixel protocols / ICs the decoder accepts on its data input (WS2811, WS2814, …), as the vendor names them. Resolved to pixels / pixel-ics entries like a controller's outputs.protocols."
        }
      }
    },
    "outputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Output channels (a DMX512 output counts as one channel per universe)"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "What the outputs carry: pixel-data (isolated, boosted or switched pixel data), dmx512, pwm (MOSFET/dimmer outputs), relay, servo, power",
          "items": { "enum": ["pixel-data", "dmx512", "pwm", "relay", "servo", "power"] }
        },
        "connector": { "$ref": "common.json#/definitions/output_connector" }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "related_connectors": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
