{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/pixel-decoder.json",
  "title": "Pixel Decoder",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ]
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "oneOf": [{ "$ref": "common.json#/definitions/price" }, { "type": "null" }]
    },
    "diy_or_ots": {
      "type": ["string", "null"]
    },
    "inputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocols": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "Pixel protocols / ICs the decoder accepts on its data input (WS2811, WS2814, …), as the vendor names them. Resolved to pixels / pixel-ics entries like a controller's outputs.protocols."
        }
      }
    },
    "outputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_channels": {
          "type": ["integer", "null"]
        },
        "pixel_types": {
          "type": ["string", "null"]
        },
        "connectors": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"]
        }
      }
    },
    "related_connectors": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
