{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/pixel.json",
  "title": "LED Pixel",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Other names this part is sold or listed under (alternate spellings, rebrands, clone part numbers). Name references elsewhere (a controller's outputs.protocols, a library's supported_ics) resolve against name, aliases and variants[].name."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_year": {
      "type": ["integer", "null"],
      "description": "First date on datasheet or based on trends"
    },
    "spec_update_year": {
      "type": ["integer", "null"],
      "description": "Year specs were significantly updated (e.g., WS2812B PWM change in 2018)"
    },
    "creator": {
      "$ref": "common.json#/definitions/creator",
      "description": "Original designer of the IC"
    },
    "manufacturers": {
      "$ref": "common.json#/definitions/manufacturers",
      "description": "Companies that build it, when they differ from the creator"
    },
    "vendors": { "$ref": "common.json#/definitions/vendors", "description": "Where it is sold" },
    "notes": {
      "type": ["string", "null"]
    },
    "data": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Signalling / protocol characteristics",
      "properties": {
        "type": {
          "type": ["string", "null"],
          "description": "Protocol family (WS2812, APA102, ...)"
        },
        "clocked": {
          "type": ["boolean", "null"],
          "description": "True for protocols with a separate clock line (APA102-style)"
        },
        "bitrate": {
          "description": "Max/fixed data bit rate",
          "$ref": "common.json#/definitions/frequency"
        },
        "bitrate_notes": {
          "type": ["string", "null"]
        },
        "pixel_size_bits": {
          "type": ["integer", "null"],
          "description": "Total bits per pixel on the data line (e.g. 24 for 3x8-bit RGB, 32 for APA102 frames). pixel_rate_max is DERIVED from bitrate / pixel_size_bits at build time - do not store it."
        },
        "pixel_size_notes": {
          "type": ["string", "null"]
        },
        "backup_line": {
          "type": ["boolean", "null"],
          "description": "Has a failover/backup data wire"
        },
        "max_per_string": {
          "type": ["integer", "string", "null"],
          "description": "Hardware limit on string length (not FPS related)"
        },
        "max_per_string_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "color": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": ["string", "null"],
          "description": "Channel order (RGB, GRB, RGBW, ...)"
        },
        "channel_bits": {
          "$ref": "common.json#/definitions/channel_bits"
        },
        "channel_bits_notes": {
          "type": ["string", "null"]
        },
        "brightness_control": {
          "$ref": "common.json#/definitions/brightness_control"
        },
        "pwm_frequency": {
          "$ref": "common.json#/definitions/frequency"
        },
        "pwm_frequency_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "electrical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "led_voltage": {
          "$ref": "common.json#/definitions/voltage"
        },
        "led_voltage_notes": {
          "type": ["string", "null"]
        },
        "supply_voltage": {
          "description": "Supply voltage (VCC / VDD) of the built-in driver IC",
          "$ref": "common.json#/definitions/voltage"
        },
        "supply_voltage_notes": {
          "type": ["string", "null"]
        },
        "gpio": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "min": {
              "description": "Lowest valid logic-high input",
              "$ref": "common.json#/definitions/voltage"
            },
            "min_notes": {
              "type": ["string", "null"]
            },
            "max": {
              "description": "Max voltage at data pin",
              "$ref": "common.json#/definitions/voltage"
            }
          }
        },
        "channel_current": {
          "$ref": "common.json#/definitions/current"
        },
        "channel_current_notes": {
          "type": ["string", "null"]
        },
        "quiescent_current": {
          "$ref": "common.json#/definitions/current"
        },
        "wattage": {
          "description": "Power per pixel",
          "$ref": "common.json#/definitions/power"
        }
      }
    },
    "physical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "LED packages the pixel is offered in",
          "items": { "$ref": "common.json#/definitions/led_package" }
        },
        "pin_count": {
          "type": ["integer", "null"],
          "description": "Pins on the primary package"
        }
      }
    },
    "variants": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "differences": {
            "type": "string"
          }
        }
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "technical_notes": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "description": "Single price (USD unless {amount, currency}) or published quantity tiers",
      "oneOf": [
        {
          "$ref": "common.json#/definitions/price"
        },
        {
          "$ref": "common.json#/definitions/price_tiers"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
