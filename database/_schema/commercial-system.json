{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/commercial-system.json",
  "title": "Commercial Pixel System",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "definitions": {
    "color_type": {
      "enum": ["RGB", "RGBW", "RGBMA", "W", "WW", "CTA"],
      "description": "RGB; RGBW (with white); RGBMA (with mint and amber); W (white); WW (warm white); CTA (tunable white, color-temperature adjustable). Add new ones here."
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_year": {
      "$ref": "common.json#/definitions/year",
      "description": "Year the system was introduced"
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ]
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "target_market": {
      "type": ["string", "null"]
    },
    "core_tech": {
      "type": ["string", "null"]
    },
    "specs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "pixels_per_run": {
          "type": ["integer", "null"]
        },
        "dimming_bits": {
          "$ref": "common.json#/definitions/channel_bits",
          "description": "Dimming resolution in bits per channel; a list when selectable (8 or 16)"
        },
        "dimming_notes": {
          "type": ["string", "null"]
        },
        "color_type": {
          "description": "Emitter colors of the variants sold: one, or a list",
          "oneOf": [
            { "$ref": "#/definitions/color_type" },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/color_type" }
            }
          ]
        },
        "dedicated_psu": {
          "type": ["boolean", "null"]
        }
      }
    },
    "pricing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "price_range": {
          "$ref": "common.json#/definitions/price_range"
        },
        "examples": {
          "type": "array",
          "description": "Published price points (a specific kit, string, or panel)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["price"],
            "properties": {
              "item": {
                "type": "string",
                "description": "What the price buys, e.g. \"7 Ball String\""
              },
              "price": { "$ref": "common.json#/definitions/price" },
              "pixels": {
                "type": "integer",
                "minimum": 1,
                "description": "Individually addressable pixels the price buys; drives the per-pixel price comparison"
              },
              "notes": { "type": "string" },
              "source": { "$ref": "common.json#/definitions/price_source" }
            }
          }
        }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"]
        }
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
