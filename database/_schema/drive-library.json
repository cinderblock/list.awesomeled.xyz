{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/drive-library.json",
  "title": "Drive Library",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Other names the library/firmware goes by (abbreviations, former names). Name references elsewhere (a controller's software.firmware / works_with) resolve against name and aliases."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ],
      "description": "active = maintained; end-of-life = archived/unmaintained"
    },
    "creator": {
      "$ref": "common.json#/definitions/creator",
      "description": "Original designer or maker"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "language": {
      "$ref": "common.json#/definitions/programming_languages",
      "description": "Implementation language(s)"
    },
    "license": {
      "type": ["string", "null"],
      "description": "SPDX-style id (MIT, GPL-3.0, ...)"
    },
    "platforms": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Supported platforms (Arduino, ESP32, Teensy, Raspberry Pi, Linux, ...)"
    },
    "protocols": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Control protocols implemented (Art-Net, sACN, DDP, DMX512, ...)"
    },
    "hardware": {
      "type": ["string", "null"],
      "description": "Freeform supported-hardware summary"
    },
    "features": {
      "type": ["string", "null"]
    },
    "supported_ics": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Pixel IC / protocol names the library can drive"
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "The project's website, when it has one apart from its repository",
          "type": ["string", "null"],
          "format": "uri"
        },
        "repo": {
          "description": "Source repository (GitHub, GitLab, ...)",
          "type": ["string", "null"],
          "format": "uri"
        },
        "youtube": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "instructional_resources": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
