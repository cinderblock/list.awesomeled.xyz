{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/microboard.json",
  "title": "DIY MicroBoard",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Other names the board is sold or referred to under. Name references elsewhere (a controller's inputs.requires_host) resolve against name and aliases."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_year": {
      "type": ["integer", "null"]
    },
    "creator": {
      "$ref": "common.json#/definitions/creator",
      "description": "Original designer or maker"
    },
    "manufacturers": {
      "$ref": "common.json#/definitions/manufacturers",
      "description": "Companies that build it, when they differ from the creator"
    },
    "vendors": { "$ref": "common.json#/definitions/vendors", "description": "Where it is sold" },
    "notes": {
      "type": ["string", "null"]
    },
    "technical_notes": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "oneOf": [{ "$ref": "common.json#/definitions/price" }, { "type": "null" }]
    },
    "compute": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "soc": {
          "type": ["string", "null"],
          "description": "SoC / microcontroller part, spelled as its maker does (ESP32-S3, nRF52840, BCM2711)"
        },
        "cpu": {
          "type": ["string", "null"]
        },
        "isa": {
          "enum": ["Xtensa", "RISC-V", "AVR", "ARMv6-M", "ARMv6Z", "ARMv7-M", "ARMv7-A", "ARMv8-A"],
          "description": "Instruction set architecture"
        },
        "clock_speed": {
          "$ref": "common.json#/definitions/frequency"
        },
        "flash": {
          "description": "On-board program flash or eMMC (removable cards go in io.storage); a list when variants differ",
          "oneOf": [
            { "$ref": "common.json#/definitions/memory" },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "common.json#/definitions/memory" }
            }
          ]
        },
        "flash_notes": {
          "type": "string",
          "description": "Kind (eMMC, SPI flash) or reserved space"
        },
        "ram": {
          "description": "RAM; a list when variants differ",
          "oneOf": [
            { "$ref": "common.json#/definitions/memory" },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "common.json#/definitions/memory" }
            }
          ]
        },
        "ram_notes": { "type": "string" },
        "linux": {
          "type": ["boolean", "null"],
          "description": "Runs a Linux OS (vs bare-metal MCU)"
        }
      }
    },
    "connectivity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "On-board connectivity. 'add-on' = available through a USB dongle, shield, FeatherWing or module, not on the board itself.",
      "properties": {
        "wifi": {
          "description": "Bands on the board, false when none, or 'add-on'",
          "oneOf": [
            { "enum": [false, "add-on"] },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["2.4GHz", "5GHz", "6GHz"] }
            }
          ]
        },
        "ethernet": {
          "enum": [false, "100BASE-TX", "1000BASE-T", "add-on"],
          "description": "On-board Ethernet speed, false when none, or 'add-on'"
        },
        "bluetooth": {
          "description": "Version ('4.2', '5.0 LE'), 'BLE', false when none, or 'add-on'",
          "oneOf": [{ "type": "boolean" }, { "type": "string" }]
        },
        "usb": {
          "description": "USB ports, kind and count ('OTG', 'OTG x2, 3.0 x2', 'Power + UART'); false when none",
          "oneOf": [{ "const": false }, { "type": "string" }]
        },
        "serial": {
          "type": "boolean",
          "description": "TTL serial / UART"
        },
        "poe": {
          "enum": [true, false, "add-on"],
          "description": "Powered over Ethernet on the board, or with an add-on module"
        }
      }
    },
    "power": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "voltage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "min": { "$ref": "common.json#/definitions/voltage" },
            "max": { "$ref": "common.json#/definitions/voltage" }
          }
        },
        "gpio_voltage": {
          "$ref": "common.json#/definitions/voltage"
        }
      }
    },
    "io": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_outputs": {
          "type": ["integer", "null"],
          "description": "Usable data outputs for pixels"
        },
        "storage": {
          "enum": [false, "microSD", "SD", "add-on"],
          "description": "Card slot on the board, false when none, or 'add-on' (shield)"
        },
        "bms": {
          "enum": [false, "1S", "diode"],
          "description": "Battery handling: a 1S LiPo charger, a diode power path (battery input without charging), or none"
        },
        "imu": {
          "enum": [false, true, "add-on"],
          "description": "Motion sensor on the board, or through an add-on (FeatherWing)"
        }
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "measurements": {
      "$ref": "common.json#/definitions/measurements"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
