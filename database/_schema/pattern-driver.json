{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/pattern-driver.json",
  "title": "Pattern Driver Software",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "definitions": {
    "direction": {
      "enum": ["Input", "Output", "Both", false],
      "description": "Input: the software receives it. Output: it sends it. Both. false: not supported (checked). Leave the field out when unknown."
    },
    "other_io": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Short names, one per item ('MIDI', 'OSC', 'NDI', 'Spout'); prose goes in other_notes"
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Other names the software goes by (abbreviations like FPP, former names). Name references elsewhere (a controller's software.firmware / works_with) resolve against name and aliases."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        },
        {
          "const": "beta"
        }
      ]
    },
    "creator": {
      "$ref": "common.json#/definitions/creator",
      "description": "Original designer or maker"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "language": {
      "$ref": "common.json#/definitions/programming_languages",
      "description": "Language users write code in, when programmatic"
    },
    "platforms": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Where this software runs, split by kind. UIs collapse a full desktop set to 'All OS'.",
      "properties": {
        "os": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "enum": ["Windows", "macOS", "Linux"]
          }
        },
        "mobile": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "enum": ["Android", "iOS"]
          }
        },
        "web": {
          "type": ["boolean", "null"],
          "description": "Runs in a browser"
        },
        "hardware": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "Embedded/SBC targets the software itself runs on (ESP32, Raspberry Pi, ...)"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "pricing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "price": {
          "type": ["string", "number", "null"]
        },
        "source": { "$ref": "common.json#/definitions/price_source" },
        "license_type": {
          "type": ["string", "null"],
          "description": "perpetual, subscription, donationware, ..."
        },
        "tiers": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tier": {
                "type": "string"
              },
              "price": {
                "type": ["string", "number"]
              },
              "features": {
                "type": "string"
              },
              "limitations": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "demo": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": ["string", "boolean", "null"]
            },
            "limitations": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "capabilities": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "live": {
          "type": ["boolean", "null"],
          "description": "Live output to actual lights"
        },
        "designer": {
          "type": ["boolean", "null"],
          "description": "Design patterns offline"
        },
        "visualizer": {
          "enum": [false, true, "1D", "2D", "3D"],
          "description": "Preview of the layout: its dimensions when known, true when it has one of unknown kind, false when none"
        },
        "visualizer_notes": {
          "type": ["string", "null"]
        },
        "programmatic": {
          "anyOf": [{ "$ref": "#/definitions/direction" }, { "const": true }],
          "description": "User code can drive inputs, outputs or both; true when the direction isn't recorded"
        }
      }
    },
    "inputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "video": {
          "$ref": "#/definitions/direction",
          "description": "Video in (capture, NDI, Spout...) and/or out"
        },
        "audio": {
          "$ref": "#/definitions/direction",
          "description": "Audio in (sound-reactive) and/or out (plays audio with a show)"
        },
        "adc": {
          "type": ["boolean", "null"],
          "description": "Analog input (sensors)"
        },
        "other": {
          "$ref": "#/definitions/other_io",
          "description": "Other inputs: control protocols, media and devices"
        },
        "other_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "outputs": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocols": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "artnet": { "$ref": "#/definitions/direction" },
            "sacn": { "$ref": "#/definitions/direction" },
            "dmx": {
              "$ref": "#/definitions/direction",
              "description": "DMX512 through an interface (USB, RS-485)"
            },
            "kinet": { "$ref": "#/definitions/direction" },
            "ddp": { "$ref": "#/definitions/direction" },
            "opc": {
              "$ref": "#/definitions/direction",
              "description": "Open Pixel Control"
            },
            "spi": { "$ref": "#/definitions/direction" }
          }
        },
        "dmx_notes": {
          "type": ["string", "null"]
        },
        "gpio": { "$ref": "#/definitions/direction" },
        "serial": { "$ref": "#/definitions/direction" },
        "serial_notes": {
          "type": ["string", "null"]
        },
        "other": {
          "$ref": "#/definitions/other_io",
          "description": "Other outputs: control protocols, media and devices"
        },
        "other_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "integrations": {
      "type": ["string", "null"],
      "description": "Controllers this software targets"
    },
    "technical_notes": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "mirror": {
          "type": ["string", "null"]
        }
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    },
    "license": {
      "type": ["string", "null"],
      "description": "SPDX license id (GPL-3.0, MIT, ...) for open-source software"
    }
  }
}
