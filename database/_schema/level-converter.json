{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/level-converter.json",
  "title": "Level Converter",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Other part numbers / names for the same device (vendor prefixes, package suffixes). Name references elsewhere (a controller's outputs.driver.IC) resolve against name and aliases."
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ]
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "description": "Single price (USD unless {amount, currency}) or published quantity tiers",
      "oneOf": [
        { "$ref": "common.json#/definitions/price" },
        { "$ref": "common.json#/definitions/price_tiers" }
      ]
    },
    "io": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": ["integer", "null"]
        },
        "interface": {
          "type": ["string", "null"]
        },
        "buffered": {
          "type": ["boolean", "null"]
        }
      }
    },
    "electrical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_voltage": {
          "type": ["string", "number", "null"]
        },
        "max_current": {
          "type": ["string", "number", "null"]
        },
        "input_high_voltage": {
          "description": "Lowest input voltage guaranteed to read as high (the datasheet's VIH min) when the part is powered to output 5 V; for dual-supply parts, with the input side on the controller's 3.3 V rail. A 3.3 V controller can only drive the part when this is below 3.3 V. Put the datasheet's test condition in input_high_voltage_notes.",
          "$ref": "common.json#/definitions/voltage"
        },
        "input_high_voltage_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"]
        }
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
