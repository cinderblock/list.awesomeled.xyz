{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/diffusive-material.json",
  "title": "Diffusive Material",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [{ "$ref": "common.json#/definitions/status" }, { "type": "null" }]
    },
    "creator": {
      "$ref": "common.json#/definitions/creator",
      "description": "Original designer or maker"
    },
    "manufacturers": {
      "$ref": "common.json#/definitions/manufacturers",
      "description": "Companies that build it, when they differ from the creator"
    },
    "vendors": { "$ref": "common.json#/definitions/vendors", "description": "Where it is sold" },
    "materials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "What it is made of. Polymer codes: PMMA (acrylic), PC (polycarbonate), PET (polyester film or fibre), PVC (vinyl), PE / LDPE / HDPE / XLPE (polyethylenes; XLPE = cross-linked, incl. PEX and Plastazote), PP, EVA, PCL (polycaprolactone), TPU, PAN (acrylic fibre); plus paper, silicone, and 'ethylene copolymer' where the exact polymer is unpublished.",
      "items": {
        "enum": [
          "PMMA",
          "PC",
          "PET",
          "PVC",
          "PE",
          "LDPE",
          "HDPE",
          "XLPE",
          "PP",
          "EVA",
          "PCL",
          "TPU",
          "PAN",
          "paper",
          "silicone",
          "ethylene copolymer"
        ]
      }
    },
    "form": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "What it comes as: sheet (rigid panel), film (thin flexible stock: film, gel, paper), foam, tube (pipe, hose, sleeving), fiber (loose fill), fabric, liquid (glue or sealant that sets), moldable (hand-shaped thermoplastic or clay), resin (moulding compound), loose (pieces, shards)",
      "items": {
        "enum": [
          "sheet",
          "film",
          "foam",
          "tube",
          "fiber",
          "fabric",
          "liquid",
          "moldable",
          "resin",
          "loose"
        ]
      }
    },
    "purpose_made": {
      "type": ["boolean", "null"],
      "description": "Designed specifically for LED diffusion"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "optical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "color_rendition": { "$ref": "#/definitions/rating" },
        "light_transmission": { "$ref": "#/definitions/rating" },
        "diffusivity": { "$ref": "#/definitions/rating" },
        "tints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Available as tinted (white/opal/coloured) and/or clear",
          "items": { "enum": ["tinted", "clear"] }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "How it is used with light: diffusive (diffuser in front of the LEDs), backlight (back-lit panel or film), edge-lit (lit from the edge, emits from the face), transmissive (engineered beam-shaping diffuser), transparent (clear, textured or optical)",
          "items": {
            "enum": ["diffusive", "backlight", "edge-lit", "transmissive", "transparent"]
          }
        }
      }
    },
    "physical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "flexible": {
          "type": "boolean",
          "description": "true: flexible; false: rigid"
        },
        "fire_retardant": {
          "type": ["boolean", "null"]
        },
        "sample_thickness": {
          "$ref": "common.json#/definitions/length",
          "description": "Thickness of the sample the ratings describe"
        },
        "sizes_available": {
          "type": ["string", "null"]
        }
      }
    },
    "pricing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "price_range": { "$ref": "common.json#/definitions/price_range" }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  },
  "definitions": {
    "rating": {
      "description": "1 (poor) to 5 (excellent); a range ('3-4') when it varies by grade or product",
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 5 },
        { "type": "string", "pattern": "^[1-5]-[1-5]$" }
      ]
    }
  }
}
