{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/adapter.json",
  "title": "Adapter",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ]
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "oneOf": [{ "$ref": "common.json#/definitions/price" }, { "type": "null" }]
    },
    "diy_or_ots": { "$ref": "common.json#/definitions/diy_or_ots" },
    "parent": {
      "type": ["string", "null"],
      "description": "Parent board/platform required"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physical": {
          "type": "object",
          "additionalProperties": {},
          "description": "Physical inputs (Wi-Fi, Ethernet, SD card, ...) as key: value/true"
        },
        "protocols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Control protocols accepted (Art-Net, E1.31, DMX512, ...)"
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firmware": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Firmware the adapter runs or is built for (FPP, WLED, ESPixelStick)"
        },
        "works_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Software commonly paired with it (xLights, WLED)"
        }
      }
    },
    "outputs": { "$ref": "common.json#/definitions/pixel_outputs" },
    "power": { "$ref": "common.json#/definitions/power_input" },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    }
  }
}
