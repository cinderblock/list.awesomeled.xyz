{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awesomeled.xyz/schema/connector.json",
  "title": "Connector",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "common.json#/definitions/status"
        },
        {
          "type": "null"
        }
      ]
    },
    "year_introduced": {
      "type": ["integer", "null"],
      "description": "Year first introduced (0/null if unknown)"
    },
    "creator": {
      "anyOf": [
        {
          "type": ["string", "null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        }
      ],
      "description": "Originating manufacturer; does not imply off-brand incompatibility"
    },
    "manufacturers": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "vendors": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": ["string", "null"]
    },
    "aliases": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "common_applications": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "ratings": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "max_current": {
          "description": "Per-contact current rating",
          "$ref": "common.json#/definitions/current"
        },
        "max_current_notes": {
          "type": ["string", "null"]
        },
        "max_voltage": {
          "description": "Voltage rating; for a family, its highest member (variants in max_voltage_notes)",
          "$ref": "common.json#/definitions/voltage"
        },
        "max_voltage_notes": {
          "type": ["string", "null"]
        },
        "ip_rating": {
          "description": "IP rating when mated; false when not sealed",
          "$ref": "common.json#/definitions/ip_rating"
        },
        "ip_rating_notes": {
          "type": ["string", "null"]
        }
      }
    },
    "mechanical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "outline": {
          "description": "Housing shape; a list when variants differ",
          "oneOf": [
            { "$ref": "#/definitions/outline" },
            {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/outline" }
            }
          ]
        },
        "contact_type": {
          "enum": ["Pins", "Blade", "Spring", "Spring blade"],
          "description": "Pins (pin and socket), Blade (flat blades), Spring (spring-clamp or spring contacts), Spring blade (RJ45-style)"
        },
        "pitch": {
          "description": "Pin-to-pin spacing",
          "$ref": "common.json#/definitions/length"
        },
        "min_pins": {
          "type": ["integer", "null"]
        },
        "max_pins": {
          "type": ["integer", "null"]
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "description": "Rows of contacts on header-style connectors (omit for circular ones)"
        },
        "gendered": {
          "type": ["boolean", "null"],
          "description": "Distinct male/female versions"
        },
        "locking": {
          "enum": ["Friction", "Detent", "Latching", "Screw Lock", "Twist Lock"],
          "description": "How mated halves stay together"
        },
        "panel_mount": {
          "type": ["boolean", "null"]
        },
        "wire_to_wire": {
          "type": ["boolean", "null"]
        },
        "pcb_mount": {
          "enum": [false, "PTH", "SMT", "both"],
          "description": "Board-mount versions: through-hole (PTH), surface-mount (SMT), both, or false when it is cable-only"
        },
        "board_fingers": {
          "type": ["boolean", "null"]
        }
      }
    },
    "termination": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "solder": {
          "type": ["boolean", "null"]
        },
        "screw_terminal": {
          "type": ["boolean", "null"]
        },
        "crimp": {
          "type": ["boolean", "null"]
        },
        "crimp_tool": {
          "type": ["string", "null"]
        },
        "crimp_tool_cost": {
          "type": ["string", "null"]
        },
        "idc": {
          "type": ["boolean", "null"],
          "description": "Insulation displacement connection"
        },
        "smallest_gauge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "description": "Thinnest wire it accepts, as an AWG number (the larger number)"
        },
        "largest_gauge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "description": "Thickest wire it accepts, as an AWG number (the smaller number)"
        }
      }
    },
    "wiring": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "pinout": {
          "type": ["string", "null"]
        },
        "convention": {
          "type": ["string", "null"]
        },
        "colors": {
          "type": ["string", "null"],
          "description": "Available housing colors"
        }
      }
    },
    "links": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "product": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "digikey": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "mouser": {
          "type": ["string", "null"],
          "format": "uri"
        }
      }
    },
    "technical_notes": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "datasheet": { "$ref": "common.json#/definitions/datasheet" },
    "image": {
      "$ref": "common.json#/definitions/image"
    },
    "images": {
      "$ref": "common.json#/definitions/images"
    },
    "other_links": { "$ref": "common.json#/definitions/other_links" },
    "related": {
      "$ref": "common.json#/definitions/related"
    },
    "sources": {
      "$ref": "common.json#/definitions/sources"
    },
    "dead_links": {
      "$ref": "common.json#/definitions/dead_links"
    },
    "price_source": { "$ref": "common.json#/definitions/price_source" },
    "price": {
      "description": "Single price (USD unless {amount, currency}) or published quantity tiers",
      "oneOf": [
        {
          "$ref": "common.json#/definitions/price"
        },
        {
          "$ref": "common.json#/definitions/price_tiers"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "outline": { "enum": ["Rectangular", "Circular", "Triangular"] }
  }
}
